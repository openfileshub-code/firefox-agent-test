{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Firefox Agent User Tool Settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "same_tab_by_default": { "type": "boolean" },
        "allow_new_tab": { "type": "boolean" },
        "allow_site_search": { "type": "boolean" },
        "allow_scroll": { "type": "boolean" },
        "forbid_placeholder_urls": { "type": "boolean" },
        "prefer_native_video_controls": { "type": "boolean" },
        "verify_after_mutation": { "type": "boolean" },
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 5 },
        "relevance_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "volume_tolerance": { "type": "number", "minimum": 0, "maximum": 0.2 },
        "theater_confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "sites": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "aliases": { "type": "array", "items": { "type": "string" } },
          "intents": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "description": { "type": "string" },
                "trigger_examples": { "type": "array", "items": { "type": "string" } },
                "action": { "type": "string" },
                "tool": { "type": "string" },
                "actions": { "type": "array", "items": { "type": "string" } },
                "allowed_tools": { "type": "array", "items": { "type": "string" } },
                "forbidden_tools": { "type": "array", "items": { "type": "string" } },
                "forbidden": { "type": "array", "items": { "type": "string" } },
                "action_map": { "type": "object" },
                "selection_strategy": { "type": "string" },
                "fallback": { "type": "string" },
                "verify_fields": { "type": "array", "items": { "type": "string" } },
                "forbid_site_search": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "intents": { "type": "object" },
    "policies": {
      "type": "object",
      "properties": {
        "same_tab_context": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "block_tools_if_context_locked": { "type": "array", "items": { "type": "string" } }
          }
        },
        "no_unrequested_scroll": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "block_tool": { "type": "string" }
          }
        },
        "no_placeholder_urls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "patterns": { "type": "array", "items": { "type": "string" } }
          }
        },
        "video_context_drift": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "error_code": { "type": "string" }
          }
        }
      }
    },
    "override_phrases": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "debug": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "dump_dom_on_error": { "type": "boolean" },
        "keep_error_screenshots": { "type": "boolean" }
      }
    }
  },
  "required": ["version", "global"]
}
